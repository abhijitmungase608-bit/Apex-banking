# APEX BANKING - ENVIRONMENT CONFIGURATION
PORT=4000
NODE_ENV=development
API_PREFIX=/api/v1

# Security & Tokens
JWT_SECRET=apex_production_vault_jwt_super_secret_key_99018274
JWT_EXPIRES_IN=3600s
REFRESH_TOKEN_SECRET=apex_refresh_vault_key_2026_super_secure
REFRESH_TOKEN_EXPIRES_IN=7d

# Database (PostgreSQL)
DATABASE_URL=postgresql://apex_admin:ApexSecurePassword2026@localhost:5432/apex_banking?schema=public

# Redis Cache & Distributed Lock
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Sandbox Mode (true for high-fidelity test adapters with zero fake balances)
APEX_SANDBOX_MODE=true

# Banking Integration Credentials (Sandbox Mock)
NPCI_UPI_SWITCH_URL=https://sandbox.npci.org.in/upi/v2
RBI_CLEARING_SWITCH_URL=https://sandbox.rbi.org.in/payments/v1
NSDL_PAN_VERIFICATION_URL=https://sandbox.tin-nsdl.com/pan/v3
UIDAI_AADHAAR_OTP_URL=https://sandbox.uidai.gov.in/auth/v2.5
SMS_GATEWAY_DLT_KEY=APEX_DLT_TEST_SECRET
